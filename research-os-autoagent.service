[Unit]
Description=Research OS Auto-Agent
Documentation=https://github.com/research-os/research-os
After=network.target
Wants=network.target

[Service]
Type=oneshot
User=aaaut
Group=aaaut
WorkingDirectory=/home/aaaut/research-os
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=RESEARCH_OS_ROOT=/home/aaaut/research-os
ExecStart=/home/aaaut/research-os/auto-agent.sh
StandardOutput=append:/home/aaaut/research-os/logs/auto-agent/systemd.log
StandardError=append:/home/aaaut/research-os/logs/auto-agent/systemd-error.log
TimeoutSec=300

# Resource limits
MemoryLimit=512M
CPUQuota=50%

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/aaaut/research-os/logs /home/aaaut/research-os/.git

[Install]
WantedBy=multi-user.target