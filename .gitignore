# =============================================================================
# Keep These (Do Not Ignore)
# =============================================================================
!.gitignore
!.gitattributes
!.github/
!.vscode/
!vercel.json
!docker-compose.yml
!docker-compose.*.yml
!package.json
!package-lock.json
!tsconfig.json
!tailwind.config.ts
!postcss.config.js
!next.config.ts
!next.config.ts.backup
!vitest.config.ts
!vitest.setup.ts
!smoke.test.ts
!README.md
!LICENSE
!CHANGELOG.md
!.env.example
!.env.template
!.dockerignore
!.prettierrc
!.prettierignore
!.eslintrc
!.eslintignore
!.stylelintrc
!.stylelintignore
!.editorconfig
!.nvmrc
